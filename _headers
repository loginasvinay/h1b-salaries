# Cloudflare Pages response headers (headers only - no redirect rules in this project).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Data shards change at most once per quarterly refresh.
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# CSS/JS are referenced as /file?v=<content hash> on every page, so a week of caching is safe.
/*.js
  Cache-Control: public, max-age=604800

/style.css
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
